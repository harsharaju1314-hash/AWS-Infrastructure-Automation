# Example Terraform Variables Configuration
# Copy this file to 'terraform.tfvars' and customize values as needed.

aws_region         = "us-east-1"
environment        = "dev"
project_name       = "aws-infra-automation"
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
availability_zone  = "us-east-1a"
instance_type      = "t3.micro"
key_name           = ""          # e.g. "my-ec2-keypair" (Must exist in the selected AWS region)
allowed_ssh_cidr   = "0.0.0.0/0" # In production, restrict to your IP: "203.0.113.4/32"
