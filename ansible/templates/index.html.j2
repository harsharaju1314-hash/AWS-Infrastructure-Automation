<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AWS Infrastructure Automation - Live</title>
    <style>
        :root {
            --primary: #2563eb;
            --success: #16a34a;
            --dark: #0f172a;
            --card-bg: #1e293b;
            --text-light: #f8fafc;
            --text-muted: #94a3b8;
            --border: #334155;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }
        body {
            background-color: var(--dark);
            color: var(--text-light);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }
        .container {
            max-width: 720px;
            width: 100%;
            background-color: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 2.5rem;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.5);
        }
        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border);
            padding-bottom: 1.5rem;
            margin-bottom: 1.5rem;
        }
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background-color: rgba(22, 163, 74, 0.2);
            color: var(--success);
            padding: 0.35rem 0.85rem;
            border-radius: 9999px;
            font-size: 0.875rem;
            font-weight: 600;
            border: 1px solid rgba(22, 163, 74, 0.4);
        }
        .badge-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: var(--success);
            box-shadow: 0 0 8px var(--success);
        }
        h1 {
            font-size: 1.75rem;
            font-weight: 700;
            letter-spacing: -0.025em;
        }
        p.subtitle {
            color: var(--text-muted);
            margin-top: 0.25rem;
            font-size: 0.95rem;
        }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1rem;
            margin-top: 1.5rem;
        }
        .info-card {
            background-color: rgba(15, 23, 42, 0.6);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1rem 1.25rem;
        }
        .info-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-bottom: 0.25rem;
        }
        .info-value {
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--text-light);
            word-break: break-all;
        }
        .pipeline-flow {
            margin-top: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border);
        }
        .flow-title {
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
        .tag {
            background-color: #334155;
            color: #cbd5e1;
            padding: 0.35rem 0.75rem;
            border-radius: 6px;
            font-size: 0.8rem;
            font-family: monospace;
        }
        footer {
            margin-top: 1.5rem;
            text-align: center;
            font-size: 0.8rem;
            color: var(--text-muted);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div>
                <h1>AWS Infrastructure Automation</h1>
                <p class="subtitle">Automated Provisioning & Configuration Pipeline</p>
            </div>
            <span class="badge">
                <span class="badge-dot"></span>
                HEALTHY
            </span>
        </div>

        <div class="grid">
            <div class="info-card">
                <div class="info-label">Host Name</div>
                <div class="info-value">{{ ansible_hostname }}</div>
            </div>
            <div class="info-card">
                <div class="info-label">Server IP</div>
                <div class="info-value">{{ ansible_default_ipv4.address }}</div>
            </div>
            <div class="info-card">
                <div class="info-label">Operating System</div>
                <div class="info-value">{{ ansible_distribution }} {{ ansible_distribution_version }}</div>
            </div>
            <div class="info-card">
                <div class="info-label">Web Server</div>
                <div class="info-value">Nginx (Managed by Ansible)</div>
            </div>
            <div class="info-card">
                <div class="info-label">Deployment Timestamp (UTC)</div>
                <div class="info-value">{{ ansible_date_time.iso8601 }}</div>
            </div>
            <div class="info-card">
                <div class="info-label">Status Check</div>
                <div class="info-value"><a href="/healthz" style="color: #60a5fa; text-decoration: none;">/healthz (200 OK)</a></div>
            </div>
        </div>

        <div class="pipeline-flow">
            <div class="flow-title">Deployment Stack & Tools</div>
            <div class="tags">
                <span class="tag">AWS VPC</span>
                <span class="tag">Terraform</span>
                <span class="tag">Ansible</span>
                <span class="tag">GitHub Actions</span>
                <span class="tag">Python CLI</span>
                <span class="tag">Ubuntu 22.04 LTS</span>
            </div>
        </div>
    </div>
    <footer>
        Deployed via Infrastructure-as-Code pipeline &bull; Verified via Python Automation
    </footer>
</body>
</html>
